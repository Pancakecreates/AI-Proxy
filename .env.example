HOST=127.0.0.1
PORT=8787
# Optional dedicated OpenAI/Codex listener port (OpenAI routes also work on PORT)
# OPENAI_PORT=8788
# ENABLE_ANTHROPIC=true
# ENABLE_OPENAI=true
# DEVIN_CWD=/path/to/workspace
DEVIN_MODE=bypass
DEVIN_MODEL=swe-2-1-medium
# DEVIN_THOUGHT_LEVEL=high
# DEVIN_SPEED=standard
DEVIN_SHOW_TOOLS=thinking
DEVIN_PROCESS_MODEL=in-process
# PROXY_API_KEY=your-local-key
# DEVIN_MODEL_MAP={"claude-opus-4":"deepseek-v4-pro-high"}
# DEVIN_GATEWAY_ALIASES=true

# Backends (auto-detected from OpenBot provider-runtimes / provider-accounts or PATH)
# ENABLE_DEVIN=true
# ENABLE_ANTIGRAVITY=true
# ANTIGRAVITY_ACCOUNTS=main=/path/to/.gemini,work=/path/to/account2
# ENABLE_OPENCODE=true
# OPENCODE_FILTER=go-free
# OPENCODE_PROVIDERS=opencode-go,opencode
# ENABLE_GROK=true
# XAI_API_KEY=
# ENABLE_CODEX=true
# ENABLE_COPILOT=false
# ENABLE_CURSOR=false
# ENABLE_CLINE=false
# ENABLE_MISTRAL=false
# ENABLE_KIMI=false
# ENABLE_HERMES=false
# CUSTOM_ACP_AGENTS=[{"id":"my-agent","name":"My ACP","command":"my-cli","args":["acp"],"enabled":true}]
