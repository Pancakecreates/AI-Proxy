{
  "name": "ai-proxy",
  "version": "1.4.0",
  "description": "Cross-platform Anthropic Messages & OpenAI Chat/Responses proxy (CLI + Tauri Desktop) backed by local AI CLIs.",
  "type": "module",
  "license": "MIT",
  "private": true,
  "main": "dist/index.js",
  "bin": {
    "ai-proxy": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "tsx --test test/*.test.ts",
    "desktop:dev": "npm --prefix desktop run tauri dev",
    "desktop:build": "npm --prefix desktop run tauri build"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
